# Devinso API (Devinso.Api). Server-side only: the browser talks to the
# same-origin /api/devinso proxy that next.config.ts rewrites onto this.
# Use the HTTP profile in dev - Node rejects the ASP.NET self-signed cert.
DEVINSO_API_URL=http://localhost:5200

# Origin the server fetches uploaded images from (the admin app's wwwroot).
# Server-side only: every upload URL from the API is rewritten to a path on our
# own origin (lib/api/media.ts) and proxied back to this one by the route
# handler in app/uploads/[...path], so the panel's address never reaches a
# visitor's browser. Only the server resolves this value, so in production it
# should be the admin container's INTERNAL address (http://admin:8080) rather
# than the panel's public hostname. HTTP for the same reason as above - the
# Next server rejects the ASP.NET dev certificate.
DEVINSO_MEDIA_URL=http://localhost:5100

# How long one API call may take before the page gives up on it, in ms.
DEVINSO_API_TIMEOUT_MS=8000

# --------------------------------------------------------------- caching ---
# See lib/api/cache.ts. The defaults are fine; these are the knobs for when
# they are not.

# Set to "off" to bypass every cache layer and read straight from the API.
# Useful when a bug might be a stale entry rather than a stale database.
# DEVINSO_API_CACHE=off

# Ceiling on any cached read in development, in seconds. Dev caches briefly so
# a burst of renders is one request, not so long that an admin-panel edit looks
# like it failed to save.
DEVINSO_API_DEV_TTL_SECONDS=15

# How long a failed read is remembered, in seconds. Keeps a stopped API from
# costing every render three eight-second timeouts.
DEVINSO_API_ERROR_TTL_SECONDS=10

# Shared secret for POST /api/revalidate, which drops cached data on demand
# after the admin panel publishes something. The route refuses every request
# until this is set.
# DEVINSO_REVALIDATE_SECRET=change-me
