# Devinso API (Devinso.Api). Server-side only: the browser talks to the
# same-origin /api/devinso proxy that next.config.ts rewrites onto this.
# Use the HTTP profile in dev — Node rejects the ASP.NET self-signed cert.
DEVINSO_API_URL=http://localhost:5225

# Origin serving uploaded images (the admin app's wwwroot). Must match the
# Media:BaseUrl the API is configured with, or images 404.
DEVINSO_MEDIA_URL=https://localhost:7019

# How long one API call may take before the page gives up on it, in ms.
DEVINSO_API_TIMEOUT_MS=8000
